{
  "expo": {
    "name": "AdventCompass",
    "slug": "maranatha-one",
    "owner": "rondozaicalvin",
    "scheme": "maranathaone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rondozaicalvin.adventcompass"
    },
    "android": {
      "package": "com.rondozaicalvin.adventcompass",
      "adaptiveIcon": {
        "backgroundColor": "#25516C",
        "foregroundImage": "./assets/icon-adaptive-fg.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-video",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#25516C",
          "image": "./assets/splash-mark-square.png",
          "imageWidth": 510
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/ico.png",
          "color": "#7C3AED"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to show an accurate Saturday sunset time so the Sabbath greeting ends at the right moment for your location."
        }
      ],
      "llama.rn",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WaterTank",
              "label": "Water Tank",
              "description": "Today's water intake with a one-tap + to log a cup.",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "minWidth": "110dp",
              "minHeight": "110dp",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WeeklyProgress",
              "label": "Weekly Progress",
              "description": "This week's Bible study, prayer, workout and water at a glance.",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "minWidth": "250dp",
              "minHeight": "180dp",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
