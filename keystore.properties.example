# Copy these four lines into %USERPROFILE%\.gradle\gradle.properties
# (C:\Users\CALVIN\.gradle\gradle.properties). Do not commit real passwords.
#
# After `npx expo prebuild --platform android`, MYAPP_UPLOAD_STORE_FILE can be
# a filename inside android/app, or an absolute path that survives prebuild:

MYAPP_UPLOAD_STORE_FILE=C:\\Users\\CALVIN\\keys\\adventcompass-upload.keystore
MYAPP_UPLOAD_KEY_ALIAS=upload
MYAPP_UPLOAD_STORE_PASSWORD=replace-me
MYAPP_UPLOAD_KEY_PASSWORD=replace-me
